# TunnelVault legacy SSH gateway – client setup
# ==============================================
# This file goes on the CLIENT machine (not on the gateway server).
# See DEPLOYMENT.md, section "Legacy SSH gateway".
#
# How the gateway works: logging in as gw-<TOKEN> does NOT give you a shell on
# the gateway. The gateway relays the raw SSH stream to the token's fixed target
# (target_ip:target_port), and your SSH client talks to the target's sshd end to
# end. So the gateway is always used as a ProxyCommand; a plain
# `ssh gw-<TOKEN>@<gateway>` only prints the target's SSH banner.

# ── Step 1: Generate an SSH key for the gateway (one-time) ──
#
#   ssh-keygen -t ed25519 -f ~/.ssh/id_ed25519
#   cat ~/.ssh/id_ed25519.pub   # <-- send this to the admin (it becomes the token's public key)

# ── Step 2: Add to ~/.ssh/config ─────────────────────────
# Replace <VALUES>:
#   HostName  a name for the target; only used for its known_hosts entry
#   User      your account ON THE TARGET server (not gw-<TOKEN>)
#   ProxyCommand  logs in to the gateway as gw-<TOKEN> with the key from step 1

Host my-server
    HostName     my-server
    User         <TARGET_USER>                 # e.g. ubuntu
    ProxyCommand ssh -T -i ~/.ssh/id_ed25519 gw-<YOUR_TOKEN>@<GATEWAY_HOST>
    #                          e.g. gw-xK9mQpR3vL2n@tunnel.example.com
    # IdentityFile ~/.ssh/<key accepted by the TARGET's sshd>   # if it differs

# ── Step 3: Connect ──────────────────────────────────────
#
#   ssh my-server
#
# The gateway identifies you by your key, looks up the target assigned to your
# token and relays the connection there. Authentication, host key checks, the
# shell and everything else happen between your client and the target.

# ── SCP / SFTP / port forwarding ─────────────────────────
# They work end to end with the target (the gateway only relays the stream):
#
#   scp file.txt my-server:/home/ubuntu/
#   sftp my-server
#   ssh -L 8080:localhost:8080 my-server   # forwarding is done by the target's sshd
#
# (Forwarding THROUGH the gateway itself, e.g. `ssh -L … gw-<TOKEN>@<gateway>`,
# is refused: the gateway sets AllowTcpForwarding no and PermitTTY no.)

# ── Multiple target servers (one token per target) ───────
Host server-dev
    HostName     server-dev
    User         ubuntu
    ProxyCommand ssh -T -i ~/.ssh/id_ed25519 gw-TokenForDevServer@tunnel.example.com

Host server-prod
    HostName     server-prod
    User         ubuntu
    ProxyCommand ssh -T -i ~/.ssh/id_ed25519 gw-TokenForProdServer@tunnel.example.com
