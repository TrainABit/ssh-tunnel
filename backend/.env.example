# ─────────────────────────────────────────────────────────────────────────────
# TunnelVault server configuration (backend/.env)
#
# Copy to backend/.env (installed servers: /opt/tunnelvault/backend/.env, mode 0600,
# owned by the service user). Every variable is optional unless marked REQUIRED.
# Values shown are the defaults.
# ─────────────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────────────
# 'production' refuses to start without AUTH_TOKEN.
NODE_ENV=production

# REQUIRED in production. Admin token: dashboard login (exchanged for a session
# cookie), `Authorization: Bearer <AUTH_TOKEN>` for scripts/CLI, and accepted as
# an admin device token on /ws. Generate with: openssl rand -hex 32
# Changing it logs out every dashboard session. Query-string tokens are not accepted.
AUTH_TOKEN=

# Base domain. HTTP tunnels are served on <subdomain>.DOMAIN (wildcard DNS).
DOMAIN=tunnel.local

# Public dashboard URL shown in the UI and install commands (e.g. https://tunnel.example.com).
PUBLIC_URL=

# Public URL template of HTTP tunnels. Default: http://{subdomain}.DOMAIN:PROXY_PORT
# Example with a wildcard certificate behind nginx: https://{subdomain}.tunnel.example.com
HTTP_TUNNEL_URL_TEMPLATE=

# ── Network ──────────────────────────────────────────────────────────────────
# API + dashboard + device WebSocket (/ws) + web terminal (/ws/ssh).
PORT=4000
# HTTP tunnel proxy (Host-based routing to <subdomain>.DOMAIN).
PROXY_PORT=4001
# Interface for PORT and PROXY_PORT. Behind nginx on the same host use 127.0.0.1.
BIND_HOST=0.0.0.0
# Interface for the public TCP tunnel listeners.
TCP_BIND_HOST=0.0.0.0
# Port range for TCP tunnels (devices keep their port across reconnects when possible).
TCP_PORT_MIN=10000
TCP_PORT_MAX=10999
# Max simultaneous public connections per TCP tunnel.
TCP_MAX_CONNECTIONS_PER_TUNNEL=1000
# Idle timeout (ms) of proxied HTTP tunnel streams (no whole-request deadline).
HTTP_PROXY_IDLE_TIMEOUT_MS=

# Reverse proxy trust. Unset/false = use the socket address and ignore
# X-Forwarded-* (anything else lets clients spoof their IP and dodge rate limits).
#   loopback (or true)  nginx/Caddy on the same host
#   2                   number of trusted proxy hops
#   10.0.0.0/8,1.2.3.4  list of trusted proxy addresses/subnets
TRUST_PROXY=
# Legacy alias: BEHIND_PROXY=true == TRUST_PROXY=loopback
BEHIND_PROXY=

# Extra origins allowed to call the API with a Bearer token from a browser (CORS,
# comma separated). Never enables cookies cross-origin.
ALLOWED_ORIGINS=

# ── TLS (direct, without nginx) ──────────────────────────────────────────────
# Prefer `install-server.sh --tls` (nginx + Let's Encrypt terminates TLS; then set
# BIND_HOST=127.0.0.1 and TRUST_PROXY=loopback). If you point these at files, the
# service user must be able to read them (/etc/letsencrypt is root-only).
TLS_CERT=
TLS_KEY=
# Separate certificate for the HTTP tunnel proxy (defaults to TLS_CERT/TLS_KEY).
TLS_PROXY_CERT=
TLS_PROXY_KEY=

# ── Limits ───────────────────────────────────────────────────────────────────
# Tunnels per device token (across all of its connections); per connection for AUTH_TOKEN.
MAX_TUNNELS_PER_TOKEN=10
# Concurrent device WebSocket connections per token (the oldest is replaced).
MAX_CONNECTIONS_PER_TOKEN=4
# /ws upgrade attempts and failed authentications per client IP per minute.
WS_UPGRADE_RATE_MAX=60
WS_AUTH_FAIL_MAX=10
# /api requests per client IP per minute.
API_RATE_LIMIT_PER_MIN=300
# Web terminal: concurrent sessions and connection attempts per client IP per minute.
WEB_SSH_MAX_SESSIONS=10
WEB_SSH_RATE_LIMIT_PER_MIN=10

# ── Dashboard sessions ───────────────────────────────────────────────────────
# Sliding lifetime of the dashboard login cookie, in hours.
SESSION_TTL_HOURS=12

# ── Secrets at rest ──────────────────────────────────────────────────────────
# Encrypts SSH private keys stored for the web terminal (AES-256-GCM).
# 64 hex chars (openssl rand -hex 32) or base64 of 32 bytes are used directly;
# any other string is stretched with scrypt. Unset = stored keys are disabled.
DATA_ENCRYPTION_KEY=
# Alternatively read the key from a file (0600, owned by the service user).
DATA_ENCRYPTION_KEY_FILE=
# Key rotation: put the old key here and a new one in DATA_ENCRYPTION_KEY; on
# startup every stored key is re-encrypted with the new key. Remove afterwards.
DATA_ENCRYPTION_KEY_PREVIOUS=
DATA_ENCRYPTION_KEY_PREVIOUS_FILE=

# ── Data & privacy ───────────────────────────────────────────────────────────
# SQLite database (contains tokens and secrets; kept 0600).
DB_PATH=
# Delete connection sessions (visitor IPs) older than N days. 0 = keep forever.
SESSION_RETENTION_DAYS=90
# Remove tunnels that were offline for N days. 0 = never.
TUNNEL_IDLE_RETENTION_DAYS=30
# GeoIP for sessions: off | maxmind | ip-api
#   maxmind: local lookups in GEOIP_DB (GeoLite2-City.mmdb, free MaxMind account)
#   ip-api:  sends every visitor IP to ip-api.com over plain HTTP (non-commercial only)
# GEOIP_DB set without GEOIP_PROVIDER selects maxmind.
GEOIP_PROVIDER=off
GEOIP_DB=

# ── Logging ──────────────────────────────────────────────────────────────────
# debug | info | warn | error | fatal
LOG_LEVEL=info
# pretty (default) | json
LOG_FORMAT=
# Also append logs to this file.
LOG_FILE=

# ── Notifications ────────────────────────────────────────────────────────────
# Webhook for tunnel connect/disconnect events.
WEBHOOK_URL=
# json | ntfy | slack | discord
WEBHOOK_TYPE=json

# ── Legacy SSH gateway (ForceCommand) ────────────────────────────────────────
# Spool directory for Linux user requests (processed by tunnelvault-usermgr.path).
# Unset = call `sudo manage-user.sh` directly (does not work under systemd hardening).
USERMGR_SPOOL_DIR=
# Path of manage-user.sh for the legacy sudo mode.
MANAGE_USER_SCRIPT=/opt/tunnelvault/manage-user.sh

# ── Installation metadata ────────────────────────────────────────────────────
# Where the VERSION file lives (default: two levels above backend/src).
INSTALL_DIR=
# Updater config read for the settings page (ENABLED=1, SCHEDULE=12h).
TUNNELVAULT_UPDATE_CONF=/etc/tunnelvault/update.conf
